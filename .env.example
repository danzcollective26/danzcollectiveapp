VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key

# Optional: false pauses ranked play; local practice remains available.
VITE_SNAKE_COMPETITION_ENABLED=true

# Solo servidor. Nunca usar VITE_HF_TOKEN. El Space público admite acceso
# anónimo según su cuota disponible; el token es opcional para autenticarse.
HF_TOKEN=
HF_QR_SPACE=huggingface-projects/QR-code-AI-art-generator
HF_QR_ENDPOINT=/inference
